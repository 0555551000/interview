  { cat: 'chill', text: '同事问：你这么晚还不走啊？\n我：在等代码编译。\n其实我在等编译完就开摸。' },
  { cat: 'chill', text: '面试要不要承认自己会摸鱼？\n不承认是虚伪，承认是找死。\n最好的回答：「我会合理安排工作节奏」。' },
  { cat: 'chill', text: '真正的阶级固化，不是年薪，\n是「周末要不要看手机」。' },
  { cat: 'chill', text: '打工人的梦：\n实现财务自由。\n打工人的醒：\n还有 28 年房贷要还。' },
  { cat: 'chill', text: '每次下班都在想辞职。\n每次发工资都在想算了。\n这叫「死循环中的条件判断」。' },
  { cat: 'chill', text: '面试前看段子，面试后哭着回家。\n这不是放松，这是续命。' },

  // ===== 💪 真心话 / 放松结尾 =====
  { cat: 'self', text: '所有面试过的人都有一个共同点：\n最后都会活着走出面试间。\n所以别慌，你也一样。' },
  { cat: 'self', text: '你以为面试是在被审判。\n其实面试官比你更尴尬：\n他也不知道下一个问题问啥。' },
  { cat: 'work', text: '面试失败不是你不行，\n是那家公司不识货。\n下一个才配得上你的年终奖。' },
  { cat: 'chill', text: '深呼吸，喝口水。\n最差的结果也不过是再投一份简历。\n你已经比那些没勇气面试的人强了。' },
];


// ====== 面试放松 · 段子卡片 ======
(function joker(){
    const btn = document.getElementById('jokeBtn');
    const modal = document.getElementById('jokeModal');
    if (!btn || !modal) return;

    const card = document.getElementById('jokeCard');
    const text = document.getElementById('jokeText');
    const catChips = document.getElementById('jokeCats');
    const nextBtn = document.getElementById('jokeNext');
    const copyBtn = document.getElementById('jokeCopy');
    const favBtn = document.getElementById('jokeFav');
    const favListBtn = document.getElementById('jokeFavList');
    const counter = document.getElementById('jokeCounter');
    const closeBtn = document.getElementById('jokeClose');

    const CAT_LABELS = [
        ['all',   '🎲 全部'],
        ['self',  '🤖 自嘲'],
        ['work',  '💼 职场'],
        ['tech',  '🧠 八股梗'],
        ['chill', '🍵 摸鱼'],
        ['fav',   '⭐ 收藏'],
    ];

    let curCat = 'all';
    let curIdx = 0;
    let curList = [];
    let favs = [];
    let viewingFav = false;

    try {
        favs = JSON.parse(localStorage.getItem('joke-favs') || '[]');
    } catch(e) { favs = []; }

    // 渲染分类 chip
    catChips.innerHTML = CAT_LABELS.map(([k, label]) =>
        `<button class="joke-chip${k === curCat ? ' active' : ''}" data-cat="${k}">${label}</button>`
    ).join('');
    catChips.querySelectorAll('.joke-chip').forEach(el => {
        el.addEventListener('click', () => {
            catChips.querySelectorAll('.joke-chip').forEach(c => c.classList.remove('active'));
            el.classList.add('active');
            curCat = el.dataset.cat;
            viewingFav = (curCat === 'fav');
            rebuildList();
            curIdx = 0;
            render();
        });
    });

    function rebuildList() {
        if (viewingFav) {
            // 收藏：按文本匹配从 JOKES 里找回
            curList = favs.map(f => JOKES.find(j => j.text === f)).filter(Boolean);
        } else if (curCat === 'all') {
            curList = JOKES.slice();
        } else {
            curList = JOKES.filter(j => j.cat === curCat);
        }
        // 随机打乱
        for (let i = curList.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [curList[i], curList[j]] = [curList[j], curList[i]];
        }
    }

    function render() {
        if (curList.length === 0) {
            text.innerHTML = viewingFav
                ? '<div class="joke-empty">还没收藏过段子<br><span style="font-size:12px;opacity:.7">看到喜欢的点 ☆ 收藏</span></div>'
                : '<div class="joke-empty">这个分类暂时没段子</div>';
            counter.textContent = '0 / 0';
            favBtn.classList.remove('active');
            card.classList.remove('flip');
            void card.offsetWidth;
            card.classList.add('flip');
            return;
        }
        if (curIdx >= curList.length) curIdx = 0;
        if (curIdx < 0) curIdx = curList.length - 1;
        const j = curList[curIdx];
        // 段子文本：换行 → <br>
        text.innerHTML = escapeHtml(j.text).replace(/\n/g, '<br>');
        counter.textContent = `${curIdx + 1} / ${curList.length}`;
        const isFav = favs.includes(j.text);
        favBtn.classList.toggle('active', isFav);
        favBtn.innerHTML = isFav ? '⭐ 已收藏' : '☆ 收藏';

        // 切换动画
        card.classList.remove('flip');
        void card.offsetWidth;
        card.classList.add('flip');
    }

    function next(delta) {
        if (curList.length === 0) return;
        curIdx = (curIdx + delta + curList.length) % curList.length;
        render();
    }

    nextBtn.addEventListener('click', () => next(1));
    card.addEventListener('click', (e) => {
        // 点卡面也切下一个（但避开按钮区）
        if (e.target.closest('.joke-actions') || e.target.closest('.joke-counter')) return;
        next(1);
    });

    copyBtn.addEventListener('click', () => {
        if (curList.length === 0) return;
        const t = curList[curIdx].text;
        try {
            navigator.clipboard.writeText(t);
            copyBtn.textContent = '✓ 已复制';
            setTimeout(() => copyBtn.innerHTML = '📋 复制', 1200);
        } catch(e) {}
    });

    favBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (curList.length === 0) return;
        const t = curList[curIdx].text;
        const i = favs.indexOf(t);
        if (i >= 0) favs.splice(i, 1);
        else favs.push(t);
        try { localStorage.setItem('joke-favs', JSON.stringify(favs)); } catch(e){}
        render();
        if (viewingFav) {
            rebuildList();
            if (curList.length === 0) render();
            else {
                if (curIdx >= curList.length) curIdx = curList.length - 1;
                render();
            }
        }
    });

    favListBtn.addEventListener('click', () => {
        const favChip = catChips.querySelector('.joke-chip[data-cat="fav"]');
        if (favChip) favChip.click();
    });

    closeBtn.addEventListener('click', close);
    modal.addEventListener('click', (e) => {
        if (e.target === modal) close();
    });

    function open() {
        rebuildList();
        if (curIdx >= curList.length) curIdx = 0;
        modal.classList.add('visible');
        render();
    }
    function close() {
        modal.classList.remove('visible');
    }

    btn.addEventListener('click', open);

    // 快捷键：⌘; 开关；面板内 Esc 关闭、方向键切换
    document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === ';') {
            e.preventDefault();
            if (modal.classList.contains('visible')) close(); else open();
            return;
        }
        if (!modal.classList.contains('visible')) return;
        if (e.key === 'Escape') { close(); return; }
        if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); next(1); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); next(-1); }
        else if (e.key.toLowerCase() === 'f') { e.preventDefault(); favBtn.click(); }
        else if (e.key.toLowerCase() === 'c') { e.preventDefault(); copyBtn.click(); }
    });

    // 初始化一次
    rebuildList();
})();


// ====== 面试倒计时 ======
(function interviewTimer(){
    const chip = document.getElementById('timerChip');
    const text = document.getElementById('timerText');
    const tgt = document.getElementById('timerTarget');
    const menu = document.getElementById('timerMenu');
    const toast = document.getElementById('timerToast');
    if (!chip) return;

    // 模式:countdown(倒计时) | stopwatch(正计时)
    let mode = 'countdown';
    let targetSec = 0;       // 目标秒数(仅倒计时)
    let elapsedMs = 0;       // 已累计毫秒(每次暂停累加)
    let runStart = 0;        // 当前 run 起点(running 时有效)
    let running = false;
    let rafId = null;
    let toastShown = false;

    function fmt(sec) {
        sec = Math.max(0, sec);
        const neg = sec < 0;
        const s = Math.abs(Math.floor(sec));
        const mm = String(Math.floor(s / 60)).padStart(2,'0');
        const ss = String(s % 60).padStart(2,'0');
        return (neg ? '-' : '') + mm + ':' + ss;
    }

    function getElapsedSec() {
        const total = elapsedMs + (running ? (Date.now() - runStart) : 0);
        return total / 1000;
    }

    function render() {
        const el = getElapsedSec();
        chip.classList.remove('idle','running','warn','danger','over');

        if (mode === 'stopwatch') {
            text.textContent = fmt(el);
            tgt.textContent = '正计时';
            chip.classList.add(running ? 'running' : 'idle');
            return;
        }
        // 倒计时
        const remain = targetSec - el;
        if (targetSec === 0) {
            text.textContent = '00:00';
            tgt.textContent = '未设置';
            chip.classList.add('idle');
            return;
        }
        if (remain <= 0) {
            text.textContent = '+' + fmt(-remain);
            tgt.textContent = '超时!';
            chip.classList.add('over');
            if (!toastShown) {
                showToast();
                toastShown = true;
            }
        } else if (remain <= 10) {
            text.textContent = fmt(remain);
            tgt.textContent = fmt(targetSec);
            chip.classList.add('danger');
        } else if (remain <= 30) {
            text.textContent = fmt(remain);
            tgt.textContent = fmt(targetSec);
            chip.classList.add('warn');
        } else {
            text.textContent = fmt(remain);
            tgt.textContent = fmt(targetSec);
            chip.classList.add(running ? 'running' : 'idle');
        }
    }

    function showToast() {
        toast.classList.add('visible');
        // 震动(支持移动端)
        if (navigator.vibrate) try { navigator.vibrate([120, 60, 120]); } catch(e){}
        // 播提示音
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const o = ctx.createOscillator();
            const g = ctx.createGain();
            o.frequency.value = 880;
            o.connect(g); g.connect(ctx.destination);
            g.gain.setValueAtTime(0.001, ctx.currentTime);
            g.gain.exponentialRampToValueAtTime(0.2, ctx.currentTime + 0.01);
            g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
            o.start(); o.stop(ctx.currentTime + 0.4);
        } catch(e) {}
        setTimeout(() => toast.classList.remove('visible'), 2500);
    }

    function loop() {
        render();
        if (running) rafId = requestAnimationFrame(loop);
    }

    function start() {
        if (running) return;
        if (mode === 'countdown' && targetSec === 0) {
            // 未设置目标,弹出菜单
            openMenu();
            return;
        }
        running = true;
        runStart = Date.now();
        loop();
    }
    function pause() {
        if (!running) return;
        elapsedMs += Date.now() - runStart;
        running = false;
        render();
    }
    function reset() {
        running = false;
        elapsedMs = 0;
        runStart = 0;
        toastShown = false;
        render();
    }
    function setCountdown(sec) {
        mode = 'countdown';
        targetSec = sec;
        reset();
        if (sec > 0) start();
    }
    function setStopwatch() {
        mode = 'stopwatch';
        targetSec = 0;
        reset();
        start();
    }

    // 交互
    chip.addEventListener('click', (e) => {
        if (running) pause();
        else start();
    });
    chip.addEventListener('dblclick', (e) => {
        e.preventDefault();
        reset();
    });
    chip.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        openMenu(e.clientX, e.clientY);
    });

    function openMenu(x, y) {
        menu.classList.add('visible');
        // 定位:默认在 chip 上方
        if (typeof x === 'number') {
            menu.style.left = x + 'px';
            menu.style.top = (y - 10) + 'px';
            // 调整防止超出屏幕
            requestAnimationFrame(() => {
                const r = menu.getBoundingClientRect();
                if (r.right > innerWidth) menu.style.left = (innerWidth - r.width - 10) + 'px';
                if (r.bottom > innerHeight) menu.style.top = (innerHeight - r.height - 10) + 'px';
                if (r.top < 0) menu.style.top = '10px';
            });
        } else {
            const r = chip.getBoundingClientRect();
            menu.style.left = r.left + 'px';
            menu.style.top = (r.top - 10) + 'px';
            requestAnimationFrame(() => {
                const m = menu.getBoundingClientRect();
                menu.style.top = (r.top - m.height - 8) + 'px';
            });
        }
    }
    function closeMenu() { menu.classList.remove('visible'); }

    document.addEventListener('click', (e) => {
        if (!menu.contains(e.target) && !chip.contains(e.target)) closeMenu();
    });

    menu.querySelectorAll('.tm-item[data-sec]').forEach(it => {
        it.addEventListener('click', () => {
            const s = parseInt(it.dataset.sec);
            if (s === 0) reset();
            else setCountdown(s);
            closeMenu();
        });
    });
    document.getElementById('tmStopwatch').addEventListener('click', () => {
        setStopwatch();
        closeMenu();
    });
    const cInp = document.getElementById('tmCustom');
    document.getElementById('tmCustomBtn').addEventListener('click', () => {
        const v = parseInt(cInp.value);
        if (v > 0) { setCountdown(v * 60); closeMenu(); }
    });
    cInp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') document.getElementById('tmCustomBtn').click();
    });

    // 快捷键 Cmd/Ctrl + .  快速开始/暂停
    document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === '.') {
            e.preventDefault();
            if (running) pause(); else start();
        }
    });

    // 初始
    render();
})();


// ====== 增强功能集合 ======
(function enhance(){
    const content = document.getElementById('content');
    const wrapper = document.getElementById('contentWrapper');

    // ---- 代码块:语言标签 + 复制 ----
    function decorateCodeBlocks() {
        content.querySelectorAll('pre').forEach(pre => {
            if (pre.dataset.decorated) return;
            pre.dataset.decorated = '1';

            // 提取语言
            const codeEl = pre.querySelector('code');
            let lang = '';
            if (codeEl) {
                const m = (codeEl.className || '').match(/language-([\w-]+)/) || (codeEl.className || '').match(/hljs\s+([\w-]+)/);
                if (m) lang = m[1];
            }
            if (lang) {
                const tag = document.createElement('span');
                tag.className = 'code-lang';
                tag.textContent = lang;
                pre.appendChild(tag);
            }

            // 复制按钮
            const btn = document.createElement('button');
            btn.className = 'copy-btn';
            btn.textContent = 'Copy';
            btn.addEventListener('click', async (e) => {
                e.stopPropagation();
                const text = codeEl ? codeEl.innerText : pre.innerText;
                try {
                    await navigator.clipboard.writeText(text);
                    btn.textContent = 'Copied ✓';
                    btn.classList.add('copied');
                    setTimeout(() => {
                        btn.textContent = 'Copy';
                        btn.classList.remove('copied');
                    }, 1400);
                } catch(err) {
                    // fallback
                    const ta = document.createElement('textarea');
                    ta.value = text; document.body.appendChild(ta); ta.select();
                    try { document.execCommand('copy'); } catch(e){}
                    document.body.removeChild(ta);
                    btn.textContent = 'Copied ✓';
                    setTimeout(() => { btn.textContent = 'Copy'; }, 1400);
                }
            });
            pre.appendChild(btn);
        });
    }

    // ---- 图片 lightbox ----
    function decorateImages() {
        const box = document.getElementById('lightbox');
        const img = document.getElementById('lightboxImg');
        content.querySelectorAll('img').forEach(el => {
            if (el.dataset.zoomable) return;
            el.dataset.zoomable = '1';
            el.addEventListener('click', () => {
                img.src = el.src;
                box.classList.add('visible');
            });
        });
        box.addEventListener('click', () => box.classList.remove('visible'));
    }

    // ---- 回到顶部 ----
    const backBtn = document.getElementById('backToTop');
    wrapper.addEventListener('scroll', () => {
        backBtn.classList.toggle('visible', wrapper.scrollTop > 400);
    });
    backBtn.addEventListener('click', () => {
        wrapper.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // ---- TOC 浮动按钮 ----
    const tocFab = document.getElementById('tocFab');
    const toc = document.querySelector('.toc');
    if (tocFab && toc) {
        tocFab.addEventListener('click', () => toc.classList.toggle('visible'));
        document.addEventListener('click', (e) => {
            if (toc.classList.contains('visible') &&
                !toc.contains(e.target) && e.target !== tocFab) {
                toc.classList.remove('visible');
            }
        });
    }

    // ---- 侧栏分组折叠 ----
    function bindGroupCollapse() {
        document.querySelectorAll('.file-group').forEach(g => {
            const title = g.querySelector('.group-title');
            if (!title || title.dataset.bound) return;
            title.dataset.bound = '1';
            title.addEventListener('click', (e) => {
                // 只在点击组标题本身时折叠(避免点子项冒泡)
                if (e.target === title || title.contains(e.target)) {
                    g.classList.toggle('collapsed');
                }
            });
        });
    }
    // 监听文件列表 DOM 变化,自动绑定
    const fileListEl = document.getElementById('fileList');
    if (fileListEl) {
        const mo = new MutationObserver(bindGroupCollapse);
        mo.observe(fileListEl, { childList: true, subtree: false });
        bindGroupCollapse();
    }

    // ---- 阅读时间预估 ----
    function calcReadTime(doc) {
        // 中文按字数/500 字每分钟,英文按单词/250 每分钟,简化:总字符数 / 500
        return Math.max(1, Math.round(doc.chars / 500));
    }
    // 覆写 loadDoc 后的 info 更新:用 MutationObserver 监听 contentInfo
    const infoEl = document.getElementById('contentInfo');
    const titleEl = document.getElementById('contentTitle');
    const moTitle = new MutationObserver(() => {
        // 找到当前文档
        const filename = decodeURIComponent(location.hash.slice(1));
        const doc = (window.docsData || []).find(d => d.filename === filename);
        if (!doc) return;
        if (infoEl.querySelector('.read-time')) return;
        const span = document.createElement('span');
        span.className = 'read-time';
        span.textContent = '约 ' + calcReadTime(doc) + ' 分钟';
        infoEl.appendChild(span);
    });
    moTitle.observe(titleEl, { childList: true, characterData: true, subtree: true });

    // 把 docsData 暴露给全局供阅读时间查询
    if (typeof docsData !== 'undefined') window.docsData = docsData;

    // ---- 正文命中:上一处/下一处导航 ----
    const hitNav = document.getElementById('hitNav');
    const hitInfo = document.getElementById('hitInfo');
    const hitPrev = document.getElementById('hitPrev');
    const hitNext = document.getElementById('hitNext');
    const hitClose = document.getElementById('hitClose');

    let currentHitIdx = 0;
    function getHits() { return content.querySelectorAll('mark.content-hit'); }
    function updateHitNav() {
        const hits = getHits();
        if (hits.length === 0) {
            hitNav.classList.remove('visible');
            return;
        }
        hitNav.classList.add('visible');
        hits.forEach(h => h.classList.remove('current'));
        if (currentHitIdx >= hits.length) currentHitIdx = 0;
        if (currentHitIdx < 0) currentHitIdx = hits.length - 1;
        hits[currentHitIdx].classList.add('current');
        hits[currentHitIdx].scrollIntoView({ block: 'center', behavior: 'smooth' });
        hitInfo.textContent = (currentHitIdx + 1) + '/' + hits.length;
    }
    hitPrev.addEventListener('click', () => { currentHitIdx--; updateHitNav(); });
    hitNext.addEventListener('click', () => { currentHitIdx++; updateHitNav(); });
    hitClose.addEventListener('click', () => {
        content.querySelectorAll('mark.content-hit').forEach(m => {
            const parent = m.parentNode;
            parent.replaceChild(document.createTextNode(m.textContent), m);
            parent.normalize();
        });
        hitNav.classList.remove('visible');
    });

    // 每次切换文档后重置命中状态
    const moContent = new MutationObserver(() => {
        decorateCodeBlocks();
        decorateImages();
        const hits = getHits();
        if (hits.length > 0) {
            currentHitIdx = 0;
            hitNav.classList.add('visible');
            hitInfo.textContent = '1/' + hits.length;
        } else {
            hitNav.classList.remove('visible');
        }
    });
    moContent.observe(content, { childList: true, subtree: false });
    // 初始一次
    decorateCodeBlocks();
    decorateImages();

    // ---- 快捷键 ----
    let gPressed = false; let gTimer = null;
    document.addEventListener('keydown', (e) => {
        // 在输入框里不处理大部分字母快捷键
        const inInput = ['INPUT','TEXTAREA'].includes(document.activeElement.tagName);

        // N / Shift+N  命中导航
        if (!inInput && e.key.toLowerCase() === 'n' && !e.ctrlKey && !e.metaKey) {
            if (getHits().length === 0) return;
            e.preventDefault();
            if (e.shiftKey) currentHitIdx--; else currentHitIdx++;
            updateHitNav();
            return;
        }
        // GG  回到顶部
        if (!inInput && e.key === 'g' && !e.ctrlKey && !e.metaKey) {
            if (gPressed) {
                wrapper.scrollTo({ top: 0, behavior: 'smooth' });
                gPressed = false;
                return;
            }
            gPressed = true;
            clearTimeout(gTimer);
            gTimer = setTimeout(() => { gPressed = false; }, 500);
            return;
        }
        // ?  帮助
        if (!inInput && e.key === '?' && !e.ctrlKey && !e.metaKey) {
            e.preventDefault();
            document.getElementById('helpModal').classList.toggle('visible');
            return;
        }
        // Esc 关闭模态 / lightbox
        if (e.key === 'Escape') {
            document.getElementById('helpModal').classList.remove('visible');
            document.getElementById('lightbox').classList.remove('visible');
        }
    });

    // 点击 mask 关闭帮助
    document.getElementById('helpModal').addEventListener('click', (e) => {
        if (e.target.id === 'helpModal') e.currentTarget.classList.remove('visible');
    });

    // ---- 首次访问欢迎提示 ----
    try {
        if (!localStorage.getItem('interview-welcomed')) {
            setTimeout(() => {
                document.getElementById('helpModal').classList.add('visible');
                localStorage.setItem('interview-welcomed', '1');
            }, 800);
        }
    } catch(e){}
})();


// ====== 面试录音 ======
(function recorder(){
    const btn = document.getElementById('recBtn');
    const modal = document.getElementById('recModal');
    if (!btn || !modal) return;

    const bigBtn = document.getElementById('recBigBtn');
    const timerEl = document.getElementById('recTimer');
    const wave = document.getElementById('recWave');
    const canvas = document.getElementById('recCanvas');
    const ctx = canvas.getContext('2d');
    const list = document.getElementById('recList');
    const warn = document.getElementById('recWarn');
    const closeBtn = document.getElementById('recClose');

    // ---- IndexedDB ----
    const DB = 'interview-rec';
    const STORE = 'clips';
    let dbReady = null;

    function openDB() {
        if (dbReady) return dbReady;
        dbReady = new Promise((resolve, reject) => {
            const req = indexedDB.open(DB, 1);
            req.onupgradeneeded = (e) => {
                const d = e.target.result;
                if (!d.objectStoreNames.contains(STORE)) {
                    const s = d.createObjectStore(STORE, { keyPath: 'id', autoIncrement: true });
                    s.createIndex('createdAt', 'createdAt');
                }
            };
            req.onsuccess = () => resolve(req.result);
            req.onerror = () => reject(req.error);
        });
        return dbReady;
    }
    async function dbAll() {
        const d = await openDB();
        return new Promise((resolve, reject) => {
            const tx = d.transaction(STORE, 'readonly');
            const req = tx.objectStore(STORE).getAll();
            req.onsuccess = () => resolve(req.result.sort((a,b) => b.createdAt - a.createdAt));
            req.onerror = () => reject(req.error);
        });
    }
    async function dbAdd(rec) {
        const d = await openDB();
        return new Promise((resolve, reject) => {
            const tx = d.transaction(STORE, 'readwrite');
            const req = tx.objectStore(STORE).add(rec);
            req.onsuccess = () => resolve(req.result);
            req.onerror = () => reject(req.error);
        });
    }
    async function dbUpdate(id, patch) {
        const d = await openDB();
        return new Promise((resolve, reject) => {
            const tx = d.transaction(STORE, 'readwrite');
            const store = tx.objectStore(STORE);
            const req = store.get(id);
            req.onsuccess = () => {
                const obj = req.result;
                if (!obj) return reject(new Error('not found'));
                Object.assign(obj, patch);
                const r2 = store.put(obj);
                r2.onsuccess = () => resolve();
                r2.onerror = () => reject(r2.error);
            };
            req.onerror = () => reject(req.error);
        });
    }
    async function dbDelete(id) {
        const d = await openDB();
        return new Promise((resolve, reject) => {
            const tx = d.transaction(STORE, 'readwrite');
            const req = tx.objectStore(STORE).delete(id);
            req.onsuccess = () => resolve();
            req.onerror = () => reject(req.error);
        });
    }

    // ---- 录音核心 ----
    let mediaRec = null;
    let stream = null;
    let audioCtx = null;
    let analyser = null;
    let waveRAF = null;
    let chunks = [];
    let startTs = 0;
    let timerIv = null;
    let running = false;

    function showWarn(msg) {
        warn.textContent = msg;
        warn.classList.add('visible');
    }
    function hideWarn() { warn.classList.remove('visible'); }

    function fmtTime(ms) {
        const s = Math.floor(ms / 1000);
        const m = Math.floor(s / 60);
        const r = s % 60;
        return String(m).padStart(2,'0') + ':' + String(r).padStart(2,'0');
    }
    function updateTimer() {
        timerEl.textContent = fmtTime(Date.now() - startTs);
    }

    function drawWave() {
        if (!running || !analyser) return;
        waveRAF = requestAnimationFrame(drawWave);
        const buf = new Uint8Array(analyser.fftSize);
        analyser.getByteTimeDomainData(buf);
        const w = canvas.width = canvas.clientWidth * devicePixelRatio;
        const h = canvas.height = canvas.clientHeight * devicePixelRatio;
        ctx.clearRect(0, 0, w, h);

        // 渐变线条
        const grad = ctx.createLinearGradient(0, 0, w, 0);
        grad.addColorStop(0, '#ff7eb6');
        grad.addColorStop(0.5, '#bc8cff');
        grad.addColorStop(1, '#7c9fff');
        ctx.strokeStyle = grad;
        ctx.lineWidth = 2 * devicePixelRatio;
        ctx.beginPath();
        const step = w / buf.length;
        for (let i = 0; i < buf.length; i++) {
            const v = buf[i] / 128.0;
            const y = (v * h) / 2;
            if (i === 0) ctx.moveTo(i * step, y);
            else ctx.lineTo(i * step, y);
        }
        ctx.stroke();
    }

    async function start() {
        hideWarn();
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            showWarn('浏览器不支持录音 API，请换 Chrome / Safari 最新版。');
            return;
        }
        try {
            stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        } catch (e) {
            showWarn('麦克风权限被拒。点地址栏 🔒 → 允许麦克风，然后刷新。(' + (e.name || e.message) + ')');
            return;
        }
        // 声波
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const src = audioCtx.createMediaStreamSource(stream);
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 2048;
        src.connect(analyser);

        // MediaRecorder
        chunks = [];
        let mime = 'audio/webm;codecs=opus';
        if (!MediaRecorder.isTypeSupported(mime)) mime = 'audio/webm';
        if (!MediaRecorder.isTypeSupported(mime)) mime = '';
        try {
            mediaRec = mime ? new MediaRecorder(stream, { mimeType: mime }) : new MediaRecorder(stream);
        } catch (e) {
            showWarn('MediaRecorder 初始化失败：' + e.message);
            cleanupStream();
            return;
        }
        mediaRec.ondataavailable = (e) => {
            if (e.data && e.data.size > 0) chunks.push(e.data);
        };
        mediaRec.onstop = onStopped;
        mediaRec.start(250);

        running = true;
        startTs = Date.now();
        updateTimer();
        timerIv = setInterval(updateTimer, 250);
        wave.classList.add('active');
        bigBtn.classList.add('recording');
        bigBtn.title = '停止 (空格)';
        btn.classList.add('recording');
        drawWave();
    }

    function stop() {
        if (!running) return;
        running = false;
        if (mediaRec && mediaRec.state !== 'inactive') {
            try { mediaRec.stop(); } catch(e) {}
        }
        clearInterval(timerIv); timerIv = null;
        cancelAnimationFrame(waveRAF);
        wave.classList.remove('active');
        bigBtn.classList.remove('recording');
        bigBtn.title = '开始 (空格)';
        btn.classList.remove('recording');
    }

    function cleanupStream() {
        if (stream) {
            stream.getTracks().forEach(t => t.stop());
            stream = null;
        }
        if (audioCtx && audioCtx.state !== 'closed') {
            try { audioCtx.close(); } catch(e) {}
        }
        audioCtx = null;
        analyser = null;
    }

    async function onStopped() {
        const duration = Date.now() - startTs;
        const blob = new Blob(chunks, { type: mediaRec.mimeType || 'audio/webm' });
        chunks = [];
        cleanupStream();

        if (blob.size < 500) {
            showWarn('录音太短/无声音，没保存。');
            return;
        }

        const now = new Date();
        const pad = n => String(n).padStart(2,'0');
        const name = `录音 ${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
        try {
            await dbAdd({ name, blob, duration, createdAt: Date.now(), mime: blob.type });
            await renderList();
        } catch(e) {
            showWarn('保存失败：' + e.message);
        }
    }

    // ---- 列表渲染 ----
    let audioURLs = new Map();  // id -> objectURL
    async function renderList() {
        const all = await dbAll();
        if (all.length === 0) {
            list.innerHTML = '<div class="rec-list-empty">还没录音。点红色按钮开始 · 空格键也行</div>';
            return;
        }
        // 释放旧 URL
        for (const u of audioURLs.values()) try { URL.revokeObjectURL(u); } catch(e){}
        audioURLs = new Map();

        list.innerHTML = '';
        all.forEach(r => {
            const url = URL.createObjectURL(r.blob);
            audioURLs.set(r.id, url);
            const el = document.createElement('div');
            el.className = 'rec-item';
            el.innerHTML = `
                <div class="rec-item-info">
                    <div class="rec-item-name" title="双击重命名">${escapeHtml(r.name)}</div>
                    <div class="rec-item-meta">${fmtTime(r.duration)} · ${(r.blob.size / 1024).toFixed(1)} KB</div>
                </div>
                <audio controls src="${url}" preload="none"></audio>
                <div class="rec-item-actions">
                    <button class="rec-ibtn" data-act="download" title="下载为 webm">📥</button>
                    <button class="rec-ibtn danger" data-act="delete" title="删除">🗑</button>
                </div>
            `;
            const nameEl = el.querySelector('.rec-item-name');
            nameEl.addEventListener('dblclick', () => {
                nameEl.setAttribute('contenteditable', 'true');
                nameEl.focus();
                // 全选
                const range = document.createRange();
                range.selectNodeContents(nameEl);
                const sel = window.getSelection();
                sel.removeAllRanges(); sel.addRange(range);
            });
            nameEl.addEventListener('blur', async () => {
                nameEl.removeAttribute('contenteditable');
                const newName = nameEl.textContent.trim() || r.name;
                if (newName !== r.name) {
                    try { await dbUpdate(r.id, { name: newName }); } catch(e){}
                }
            });
            nameEl.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); nameEl.blur(); }
                if (e.key === 'Escape') { nameEl.textContent = r.name; nameEl.blur(); }
            });
            el.querySelector('[data-act="download"]').addEventListener('click', () => {
                const a = document.createElement('a');
                a.href = url;
                a.download = r.name.replace(/[\\/:*?"<>|]/g, '_') + '.webm';
                document.body.appendChild(a);
                a.click();
                a.remove();
            });
            el.querySelector('[data-act="delete"]').addEventListener('click', async () => {
                if (!confirm(`删除「${r.name}」？不可恢复。`)) return;
                try {
                    await dbDelete(r.id);
                    URL.revokeObjectURL(url);
                    await renderList();
                } catch(e) { showWarn('删除失败：' + e.message); }
            });
            list.appendChild(el);
        });
    }

    // ---- 事件绑定 ----
    bigBtn.addEventListener('click', () => { running ? stop() : start(); });
    closeBtn.addEventListener('click', close);
    modal.addEventListener('click', (e) => {
        if (e.target === modal) close();
    });

    function open() {
        modal.classList.add('visible');
        renderList();
    }
    function close() {
        modal.classList.remove('visible');
        // 不主动停止录音——允许后台继续录，直到用户显式停止
    }
    btn.addEventListener('click', open);

    // 快捷键 ⌘U 打开/关闭；面板内 Space 开始/停止；Esc 关闭
    document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'u') {
            e.preventDefault();
            if (modal.classList.contains('visible')) close(); else open();
            return;
        }
        if (!modal.classList.contains('visible')) return;
        if (e.key === 'Escape') { close(); return; }
        if (e.code === 'Space' && !['INPUT','TEXTAREA'].includes(document.activeElement.tagName) && document.activeElement.getAttribute('contenteditable') !== 'true') {
            e.preventDefault();
            bigBtn.click();
        }
    });

    // 初始化列表（后台）
    renderList().catch(() => {});
})();


// ====== 三体壁纸 ======
(function wallpaper(){
    const btn = document.getElementById('wpBtn');
    const stage = document.getElementById('wpStage');
    if (!btn || !stage) return;

    const canvas = document.getElementById('wpCanvas');
    const quoteMain = document.getElementById('wpQuoteMain');
    const quoteSub = document.getElementById('wpQuoteSub');
    const nav = document.getElementById('wpNav');
    const closeBtn = document.getElementById('wpCloseBtn');
    const hudTL = document.getElementById('wpHudTL');
    const hudBR = document.getElementById('wpHudBR');

    // 6 张壁纸：每张一个 render(ctx, w, h, t) 函数
    const WALLPAPERS = [
        {
            name: '不要回答',
            quote: '不要回答！不要回答！不要回答！',
            sub: 'DO · NOT · ANSWER',
            coord: 'RA 19h03m · DEC +47°42\'',
            render(ctx, w, h, t) {
                ctx.fillStyle = '#000';
                ctx.fillRect(0, 0, w, h);

                // 星空背景
                drawStars(ctx, w, h, 200, 0.4);

                // 红岸基站：左下角一个点 + 向外电波
                const baseX = w * 0.15;
                const baseY = h * 0.82;

                // 多圈电波扩散
                for (let i = 0; i < 5; i++) {
                    const r = ((t / 1000 + i * 0.5) % 3) * Math.max(w, h) * 0.4;
                    const alpha = Math.max(0, 1 - r / (Math.max(w, h) * 1.2));
                    ctx.strokeStyle = `rgba(255, 80, 80, ${alpha * 0.35})`;
                    ctx.lineWidth = 1.5;
                    ctx.beginPath();
                    ctx.arc(baseX, baseY, r, 0, Math.PI * 2);
                    ctx.stroke();
                }

                // 红岸基站光点
                const pulse = 0.7 + Math.sin(t / 300) * 0.3;
                ctx.fillStyle = `rgba(255, 60, 60, ${pulse})`;
                ctx.shadowColor = '#ff3030';
                ctx.shadowBlur = 20;
                ctx.beginPath();
                ctx.arc(baseX, baseY, 5, 0, Math.PI * 2);
                ctx.fill();
                ctx.shadowBlur = 0;

                // 右上角三体星系：3 点标志
                const sx = w * 0.78, sy = h * 0.22;
                for (let i = 0; i < 3; i++) {
                    const ang = t / 2000 + i * Math.PI * 2 / 3;
                    const px = sx + Math.cos(ang) * 45;
                    const py = sy + Math.sin(ang) * 45;
                    ctx.fillStyle = ['#ffb040', '#5eead4', '#7c9fff'][i];
                    ctx.shadowColor = ctx.fillStyle;
                    ctx.shadowBlur = 15;
                    ctx.beginPath();
                    ctx.arc(px, py, 4, 0, Math.PI * 2);
                    ctx.fill();
                }
                ctx.shadowBlur = 0;

                // 中央大字 "警告" 虚影（纯装饰）
                ctx.font = `bold ${Math.min(w,h)*0.22}px "JetBrains Mono", monospace`;
                ctx.textAlign = 'center';
                ctx.fillStyle = `rgba(255, 60, 60, ${0.04 + Math.sin(t/400)*0.02})`;
                ctx.fillText('1379', w/2, h*0.5);
            }
        },

        {
            name: '黑暗森林',
            quote: '宇宙就是一座黑暗森林 · 每个文明都是带枪的猎人',
            sub: 'DARK · FOREST · LAW',
            coord: 'DEEP SPACE · SILENT',
            render(ctx, w, h, t) {
                // 浓厚黑暗背景
                const grad = ctx.createRadialGradient(w/2, h*0.6, 0, w/2, h*0.6, Math.max(w,h));
                grad.addColorStop(0, '#050810');
                grad.addColorStop(1, '#000');
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, w, h);

                // 星星（极少）
                drawStars(ctx, w, h, 60, 0.3);

                // 地平线——黑色森林剪影（锯齿形）
                ctx.fillStyle = '#000';
                ctx.beginPath();
                ctx.moveTo(0, h*0.72);
                const trees = 40;
                for (let i = 0; i <= trees; i++) {
                    const x = (w / trees) * i;
                    const seed = Math.sin(i * 12.9898) * 43758.5453;
                    const noise = (seed - Math.floor(seed));
                    const y = h * 0.72 - noise * h * 0.12 - h * 0.03;
                    ctx.lineTo(x, y);
                }
                ctx.lineTo(w, h);
                ctx.lineTo(0, h);
                ctx.closePath();
                ctx.fill();

                // 雾
                const fog = ctx.createLinearGradient(0, h*0.55, 0, h*0.75);
                fog.addColorStop(0, 'rgba(30,40,60,0)');
                fog.addColorStop(1, 'rgba(30,40,60,0.4)');
                ctx.fillStyle = fog;
                ctx.fillRect(0, h*0.55, w, h*0.2);

                // 两个红点 —— 瞄准光斑
                drawScope(ctx, w*0.3, h*0.58, t, 0);
                drawScope(ctx, w*0.72, h*0.62, t, Math.PI);

                // 中央极远处一颗微弱光点（"目标文明"）
                const pulse = 0.5 + Math.sin(t/600)*0.3;
                ctx.fillStyle = `rgba(180,200,255,${pulse*0.7})`;
                ctx.shadowColor = '#8aa0ff';
                ctx.shadowBlur = 10;
                ctx.beginPath();
                ctx.arc(w/2, h*0.5, 1.6, 0, Math.PI * 2);
                ctx.fill();
                ctx.shadowBlur = 0;
            }
        },

        {
            name: '水滴',
            quote: '强相互作用力材料 · 绝对光滑 · 不可摧毁',
            sub: 'STRONG · INTERACTIVE · DROPLET',
            coord: '木星轨道附近 · 目标: 人类舰队',
            render(ctx, w, h, t) {
                // 深空背景
                const grad = ctx.createRadialGradient(w*0.5, h*0.5, 50, w*0.5, h*0.5, Math.max(w,h)*0.7);
                grad.addColorStop(0, '#0a0d1a');
                grad.addColorStop(1, '#000');
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, w, h);
                drawStars(ctx, w, h, 160, 0.5);

                // 远处星云
                drawNebula(ctx, w*0.2, h*0.3, 180, '#5eead4', 0.15);
                drawNebula(ctx, w*0.8, h*0.7, 220, '#bc8cff', 0.12);

                // 水滴：镜面金属+尖头椭球，居中缓慢旋转
                const cx = w/2, cy = h/2;
                const dr = Math.min(w, h) * 0.18;  // 半径
                const spin = t / 3000;

                ctx.save();
                ctx.translate(cx, cy);
                ctx.rotate(Math.sin(spin) * 0.3);

                // 主体渐变（银色镜面）
                const bodyGrad = ctx.createRadialGradient(-dr*0.3, -dr*0.4, dr*0.1, 0, 0, dr*1.3);
                bodyGrad.addColorStop(0, '#ffffff');
                bodyGrad.addColorStop(0.3, '#c8d8f0');
                bodyGrad.addColorStop(0.7, '#5a6a88');
                bodyGrad.addColorStop(1, '#0a1020');

                // 椭圆形水滴轮廓（参数方程：拉长的泪滴）
                ctx.beginPath();
                const N = 120;
                for (let i = 0; i <= N; i++) {
                    const a = i / N * Math.PI * 2;
                    // 泪滴形：上尖下圆
                    const s = Math.sin(a);
                    const c = Math.cos(a);
                    // y 向上为正
                    const r = dr * (1 + 0.4 * Math.max(0, s));
                    const x = r * c * 0.85;
                    const y = -r * s * 1.3;
                    if (i === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                }
                ctx.closePath();
                ctx.fillStyle = bodyGrad;
                ctx.fill();

                // 高光
                ctx.beginPath();
                ctx.ellipse(-dr*0.25, -dr*0.45, dr*0.28, dr*0.15, -0.4, 0, Math.PI*2);
                ctx.fillStyle = 'rgba(255,255,255,0.75)';
                ctx.fill();

                // 环境反射光（下半部淡蓝）
                ctx.beginPath();
                ctx.ellipse(dr*0.2, dr*0.2, dr*0.35, dr*0.1, 0.2, 0, Math.PI*2);
                ctx.fillStyle = 'rgba(120,180,255,0.15)';
                ctx.fill();

                ctx.restore();

                // 水滴外发光（警示）
                ctx.beginPath();
                ctx.arc(cx, cy, dr*1.6, 0, Math.PI*2);
                const glow = ctx.createRadialGradient(cx, cy, dr, cx, cy, dr*1.8);
                glow.addColorStop(0, 'rgba(94,234,212,0.08)');
                glow.addColorStop(1, 'rgba(94,234,212,0)');
                ctx.fillStyle = glow;
                ctx.fill();

                // 底部数据栅格
                drawDataGrid(ctx, w, h, t);
            }
        },

        {
            name: '二维化',
            quote: '降维打击 · 清理者 · 歌者文明',
            sub: 'DIMENSIONAL · STRIKE',
            coord: '太阳系 · T−00:00:12',
            render(ctx, w, h, t) {
                ctx.fillStyle = '#000';
                ctx.fillRect(0, 0, w, h);

                // 上半部：真实立体太阳系（快速收缩）
                // 下半部：已经被二维化的平面画
                const phase = (t / 6000) % 1;  // 0~1 循环

                // 中央收缩线（二维化前沿）
                const frontY = h * (0.25 + phase * 0.5);

                // 下半部（2D 化区域）—— 彩色扁平画作（梵高风）
                ctx.save();
                ctx.fillStyle = '#0a0a0e';
                ctx.fillRect(0, frontY, w, h - frontY);

                // 扁平化的"星空画" —— 梵高《星夜》质感（用大色块涂抹）
                drawFlatArt(ctx, 0, frontY, w, h - frontY, t);

                // 前沿光带
                const frontGrad = ctx.createLinearGradient(0, frontY - 30, 0, frontY + 10);
                frontGrad.addColorStop(0, 'rgba(94,234,212,0)');
                frontGrad.addColorStop(0.5, 'rgba(180,220,255,0.6)');
                frontGrad.addColorStop(1, 'rgba(94,234,212,0.3)');
                ctx.fillStyle = frontGrad;
                ctx.fillRect(0, frontY - 30, w, 40);
                ctx.restore();

                // 上半部：星空 + 仍立体的太阳系残片
                ctx.save();
                ctx.beginPath();
                ctx.rect(0, 0, w, frontY);
                ctx.clip();
                drawStars(ctx, w, h, 150, 0.6);

                // 几个立体行星（正在坠入二维）
                const planets = [
                    { x: w*0.3, y: h*0.2, r: 10, c: '#fbbf24' },  // 太阳
                    { x: w*0.45, y: h*0.15, r: 4, c: '#ff7eb6' },
                    { x: w*0.62, y: h*0.18, r: 5, c: '#5eead4' },
                    { x: w*0.78, y: h*0.12, r: 7, c: '#7c9fff' },
                ];
                planets.forEach(p => {
                    ctx.shadowColor = p.c;
                    ctx.shadowBlur = 12;
                    ctx.fillStyle = p.c;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
                    ctx.fill();
                });
                ctx.shadowBlur = 0;
                ctx.restore();

                // 扫描线（二维化处的数据流）
                ctx.strokeStyle = 'rgba(94,234,212,0.25)';
                ctx.lineWidth = 1;
                for (let i = 0; i < 8; i++) {
                    const y = frontY - (i * 8) - (t/20 % 8);
                    if (y < 0) continue;
                    ctx.beginPath();
                    ctx.moveTo(0, y);
                    ctx.lineTo(w, y);
                    ctx.stroke();
                }
            }
        },

        {
            name: '三日凌空',
            quote: '乱纪元 · 三颗恒星无解 · 文明已脱水',
            sub: 'THREE · BODY · PROBLEM',
            coord: '半人马座 α 三星系',
            render(ctx, w, h, t) {
                // 深紫暮色天空
                const sky = ctx.createLinearGradient(0, 0, 0, h);
                sky.addColorStop(0, '#1a0a2a');
                sky.addColorStop(0.5, '#3a1830');
                sky.addColorStop(1, '#0a0510');
                ctx.fillStyle = sky;
                ctx.fillRect(0, 0, w, h);

                // 远处星光
                drawStars(ctx, w, h*0.6, 80, 0.2);

                // 三颗太阳，不同大小、不同颜色、互相缠绕轨道
                const cx = w/2, cy = h*0.42;
                const orbitR = Math.min(w, h) * 0.18;
                const suns = [
                    { phase: 0, size: 55, color: '#ffe066', glow: '#ffb040' },
                    { phase: Math.PI * 2/3, size: 40, color: '#ff8060', glow: '#ff5030' },
                    { phase: Math.PI * 4/3, size: 48, color: '#ffd0a0', glow: '#ff9060' },
                ];
                suns.forEach(s => {
                    const a = t / 4000 + s.phase;
                    const sx = cx + Math.cos(a) * orbitR;
                    const sy = cy + Math.sin(a) * orbitR * 0.55;
                    // 光晕
                    const halo = ctx.createRadialGradient(sx, sy, 0, sx, sy, s.size*3);
                    halo.addColorStop(0, s.glow);
                    halo.addColorStop(0.4, 'rgba(255,180,100,0.2)');
                    halo.addColorStop(1, 'rgba(255,180,100,0)');
                    ctx.fillStyle = halo;
                    ctx.fillRect(sx - s.size*3, sy - s.size*3, s.size*6, s.size*6);
                    // 本体
                    ctx.shadowColor = s.color;
                    ctx.shadowBlur = 40;
                    ctx.fillStyle = s.color;
                    ctx.beginPath();
                    ctx.arc(sx, sy, s.size, 0, Math.PI*2);
                    ctx.fill();
                    ctx.shadowBlur = 0;
                });

                // 地平线 —— 焦土星球剪影
                ctx.fillStyle = '#0a0308';
                ctx.beginPath();
                ctx.moveTo(0, h*0.78);
                for (let x = 0; x <= w; x += 20) {
                    const seed = Math.sin(x * 0.02) * 20 + Math.sin(x * 0.05) * 10;
                    ctx.lineTo(x, h*0.78 + seed);
                }
                ctx.lineTo(w, h);
                ctx.lineTo(0, h);
                ctx.closePath();
                ctx.fill();

                // 地面上几个"脱水文明"柱状剪影
                ctx.fillStyle = '#000';
                const monuments = [0.15, 0.35, 0.55, 0.72, 0.88];
                monuments.forEach(px => {
                    const bx = w * px;
                    const bh = h * 0.12;
                    ctx.fillRect(bx - 3, h*0.78 - bh, 6, bh);
                });

                // 热浪扰动（上半部扫描带）
                const heatY = h * 0.6 + Math.sin(t/500) * 15;
                ctx.fillStyle = `rgba(255,180,80,${0.08 + Math.sin(t/300)*0.04})`;
                ctx.fillRect(0, heatY, w, 2);
            }
        },

        {
            name: '宇宙尽头',
            quote: '宇宙归零 · 把自己刻进永恒',
            sub: 'HEAT · DEATH · ENGRAVE',
            coord: 'T + 10^100 年 · 质子尺度',
            render(ctx, w, h, t) {
                ctx.fillStyle = '#000';
                ctx.fillRect(0, 0, w, h);

                // 一个极缓慢向内收缩的光点
                const cx = w/2, cy = h/2;
                const phase = (t / 15000) % 1;
                const maxR = Math.min(w, h) * 0.45;
                const r = maxR * (1 - phase);

                // 外圈多层光晕（越外越暗）
                for (let i = 8; i >= 0; i--) {
                    const rr = r * (1 + i * 0.4);
                    const alpha = (0.14 - i*0.015) * (1 - phase*0.5);
                    ctx.fillStyle = `rgba(94,234,212,${Math.max(0, alpha)})`;
                    ctx.beginPath();
                    ctx.arc(cx, cy, rr, 0, Math.PI*2);
                    ctx.fill();
                }

                // 中心亮点
                ctx.shadowColor = '#5eead4';
                ctx.shadowBlur = 40;
                ctx.fillStyle = '#ffffff';
                ctx.beginPath();
                ctx.arc(cx, cy, Math.max(2, r*0.04), 0, Math.PI*2);
                ctx.fill();
                ctx.shadowBlur = 0;

                // 四向放射的刻字（螺旋线）
                ctx.strokeStyle = 'rgba(180,220,255,0.2)';
                ctx.lineWidth = 1;
                const turns = 8;
                const N = 500;
                ctx.beginPath();
                for (let i = 0; i < N; i++) {
                    const f = i / N;
                    const ang = f * Math.PI * 2 * turns + t / 3000;
                    const rr = f * Math.min(w, h) * 0.55;
                    const x = cx + Math.cos(ang) * rr;
                    const y = cy + Math.sin(ang) * rr;
                    if (i === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                }
                ctx.stroke();

                // 残存星点（越来越少）
                const starCount = Math.floor(200 * (1 - phase*0.8));
                drawStars(ctx, w, h, starCount, 0.3);

                // 底部一行"墓志铭"
                ctx.font = `${Math.min(w,h)*0.012}px "JetBrains Mono", monospace`;
                ctx.fillStyle = 'rgba(180,220,255,0.35)';
                ctx.textAlign = 'center';
                ctx.fillText('WE·WERE·HERE', cx, h*0.92);
            }
        },
    ];

    // ---- 工具函数 ----
    // 稳定星星（基于种子，不每帧闪烁）
    const starCache = new Map();
    function drawStars(ctx, w, h, n, alpha) {
        const key = `${w}x${h}_${n}`;
        if (!starCache.has(key)) {
            const arr = [];
            for (let i = 0; i < n; i++) {
                arr.push({
                    x: Math.random() * w,
                    y: Math.random() * h,
                    r: Math.random() * 1.2 + 0.2,
                    b: 0.3 + Math.random() * 0.7
                });
            }
            starCache.set(key, arr);
        }
        const stars = starCache.get(key);
        ctx.fillStyle = '#fff';
        stars.forEach(s => {
            ctx.globalAlpha = alpha * s.b;
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.r, 0, Math.PI*2);
            ctx.fill();
        });
        ctx.globalAlpha = 1;
    }

    function drawNebula(ctx, x, y, r, color, alpha) {
        const g = ctx.createRadialGradient(x, y, 0, x, y, r);
        g.addColorStop(0, color);
        g.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.fillStyle = g;
        ctx.fillRect(x - r, y - r, r*2, r*2);
        ctx.restore();
    }

    function drawScope(ctx, x, y, t, phase) {
        // 红色瞄准光斑
        const pulse = 0.6 + Math.sin(t/400 + phase) * 0.4;
        ctx.save();
        ctx.globalAlpha = pulse;
        ctx.fillStyle = '#ff3030';
        ctx.shadowColor = '#ff3030';
        ctx.shadowBlur = 12;
        ctx.beginPath();
        ctx.arc(x, y, 2, 0, Math.PI*2);
        ctx.fill();
        ctx.shadowBlur = 0;
        // 十字线
        ctx.strokeStyle = 'rgba(255,80,80,0.3)';
        ctx.lineWidth = 0.5;
        ctx.beginPath();
        ctx.moveTo(x - 15, y); ctx.lineTo(x + 15, y);
        ctx.moveTo(x, y - 15); ctx.lineTo(x, y + 15);
        ctx.stroke();
        ctx.restore();
    }

    function drawDataGrid(ctx, w, h, t) {
        ctx.strokeStyle = 'rgba(94,234,212,0.1)';
        ctx.lineWidth = 0.5;
        const grid = 40;
        for (let x = 0; x < w; x += grid) {
            ctx.beginPath();
            ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
        }
        for (let y = 0; y < h; y += grid) {
            ctx.beginPath();
            ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
        }
    }

    // 扁平绘画（二维化区域）
    const flatArtCache = new Map();
    function drawFlatArt(ctx, x, y, w, h, t) {
        const key = `${w}x${h}`;
        if (!flatArtCache.has(key)) {
            const patches = [];
            for (let i = 0; i < 60; i++) {
                patches.push({
                    x: Math.random() * w,
                    y: Math.random() * h,
                    r: 20 + Math.random() * 50,
                    hue: Math.random() * 60 + 200,
                });
            }
            flatArtCache.set(key, patches);
        }
        const patches = flatArtCache.get(key);
        patches.forEach(p => {
            ctx.fillStyle = `hsla(${p.hue}, 70%, 40%, 0.5)`;
            ctx.beginPath();
            ctx.arc(x + p.x, y + p.y, p.r, 0, Math.PI*2);
            ctx.fill();
        });
    }

    // ---- 渲染循环 ----
    let curIdx = 0;
    let animRAF = null;
    let startTime = 0;
    const ctx = canvas.getContext('2d');

    function resize() {
        canvas.width = canvas.clientWidth * devicePixelRatio;
        canvas.height = canvas.clientHeight * devicePixelRatio;
        ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    }

    function loop() {
        if (!stage.classList.contains('visible')) return;
        const w = canvas.clientWidth;
        const h = canvas.clientHeight;
        const t = performance.now() - startTime;
        WALLPAPERS[curIdx].render(ctx, w, h, t);
        animRAF = requestAnimationFrame(loop);
    }

    function showIdx(i) {
        curIdx = (i + WALLPAPERS.length) % WALLPAPERS.length;
        const wp = WALLPAPERS[curIdx];
        // 重新触发动画
        quoteMain.style.animation = 'none';
        quoteSub.style.animation = 'none';
        void quoteMain.offsetWidth;
        quoteMain.textContent = wp.quote;
        quoteSub.textContent = wp.sub;
        quoteMain.style.animation = '';
        quoteSub.style.animation = '';
        hudBR.innerHTML = `<div class="wp-hud-label">COORDINATES</div><div class="wp-hud-val">${wp.coord}</div>`;
        // 更新 dot 激活
        nav.querySelectorAll('.wp-dot').forEach((d, idx) => {
            d.classList.toggle('active', idx === curIdx);
        });
    }

    function buildNav() {
        nav.innerHTML = '';
        WALLPAPERS.forEach((wp, idx) => {
            const d = document.createElement('div');
            d.className = 'wp-dot' + (idx === 0 ? ' active' : '');
            d.title = wp.name;
            d.addEventListener('click', (e) => {
                e.stopPropagation();
                showIdx(idx);
            });
            nav.appendChild(d);
        });
    }

    function open() {
        stage.classList.add('visible');
        resize();
        startTime = performance.now();
        buildNav();
        showIdx(0);
        loop();
    }
    function close() {
        stage.classList.remove('visible');
        cancelAnimationFrame(animRAF);
    }

    btn.addEventListener('click', open);
    closeBtn.addEventListener('click', (e) => { e.stopPropagation(); close(); });
    // 点舞台（非按钮区）切换下一张
    stage.addEventListener('click', (e) => {
        if (e.target.closest('.wp-nav') || e.target.closest('.wp-close')) return;
        showIdx(curIdx + 1);
    });

    window.addEventListener('resize', () => {
        if (stage.classList.contains('visible')) resize();
    });

    // 快捷键：⌘/ 打开；面板内 ←/→ 切换、Esc 关闭、数字 1-6 直达
    document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === '/') {
            e.preventDefault();
            if (stage.classList.contains('visible')) close(); else open();
            return;
        }
        if (!stage.classList.contains('visible')) return;
        if (e.key === 'Escape') { close(); return; }
        if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); showIdx(curIdx + 1); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); showIdx(curIdx - 1); }
        else if (/^[1-6]$/.test(e.key)) { showIdx(parseInt(e.key) - 1); }
    });
})();


// ====== 常驻背景壁纸 ======
(function wpBg(){
    const btn = document.getElementById('wpBgBtn');
    const canvas = document.getElementById('wpBgCanvas');
    const menu = document.getElementById('wpBgMenu');
    if (!btn || !canvas || !menu) return;

    const ctx = canvas.getContext('2d');
    const KEY_ON = 'wpbg-on';
    const KEY_MODE = 'wpbg-mode';

    // ---- 四种日系动漫插画场景 ----
    const MODES = {
        classroom: {
            name: '教室窗边', icon: '🏫',
            state: null,
            init(w, h) {
                const petals = [];
                for (let i = 0; i < 50; i++) {
                    petals.push({
                        x: Math.random() * w,
                        y: Math.random() * h - h,
                        size: 5 + Math.random() * 8,
                        vy: 0.4 + Math.random() * 0.6,
                        vx: (Math.random() - 0.5) * 0.3,
                        rot: Math.random() * Math.PI * 2,
                        rotSpeed: (Math.random() - 0.5) * 0.025,
                        swayPhase: Math.random() * Math.PI * 2,
                        depth: 0.4 + Math.random() * 0.6,
                    });
                }
                this.state = { petals, lastW: w, lastH: h };
            },
            render(ctx, w, h, t) {
                if (!this.state || this.state.lastW !== w || this.state.lastH !== h) this.init(w, h);
                const st = this.state;

                // ----- 1. 晚霞天空（橙→粉→紫渐变） -----
                const sky = ctx.createLinearGradient(0, 0, 0, h * 0.75);
                sky.addColorStop(0,   '#6b3a7a');
                sky.addColorStop(0.4, '#d77a8e');
                sky.addColorStop(0.75,'#f8b878');
                sky.addColorStop(1,   '#fde8b0');
                ctx.fillStyle = sky;
                ctx.fillRect(0, 0, w, h);

                // ----- 2. 太阳光晕 -----
                const sunX = w * 0.72, sunY = h * 0.55;
                const sunG = ctx.createRadialGradient(sunX, sunY, 0, sunX, sunY, h * 0.5);
                sunG.addColorStop(0,   'rgba(255, 240, 180, 0.85)');
                sunG.addColorStop(0.3, 'rgba(255, 200, 130, 0.35)');
                sunG.addColorStop(1,   'rgba(255, 180, 130, 0)');
                ctx.fillStyle = sunG;
                ctx.fillRect(0, 0, w, h);

                // ----- 3. 远景樱花树（剪影） -----
                drawSakuraTreeSilhouette(ctx, w * 0.1, h * 0.68, w * 0.18, h * 0.4, '#8a3f58');
                drawSakuraTreeSilhouette(ctx, w * 0.88, h * 0.72, w * 0.14, h * 0.35, '#7a3548');

                // ----- 4. 地面 -----
                ctx.fillStyle = '#2a1830';
                ctx.fillRect(0, h * 0.72, w, h * 0.28);

                // ----- 5. 窗框（右 1/3 区域，半透明，暗色） -----
                const winX = w * 0.05;
                const winW = w * 0.35;
                const winY = h * 0.08;
                const winH = h * 0.82;

                // 窗户玻璃（略微模糊外景）
                // 窗框本体（棕色）
                ctx.fillStyle = '#3d2818';
                ctx.fillRect(winX - 8, winY - 8, winW + 16, winH + 16);
                // 玻璃（稍亮一点的半透叠加，让外景仍可见但有"隔着玻璃"感）
                ctx.fillStyle = 'rgba(200, 220, 240, 0.06)';
                ctx.fillRect(winX, winY, winW, winH);
                // 十字窗棂
                ctx.strokeStyle = '#3d2818';
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.moveTo(winX + winW / 2, winY);
                ctx.lineTo(winX + winW / 2, winY + winH);
                ctx.moveTo(winX, winY + winH * 0.45);
                ctx.lineTo(winX + winW, winY + winH * 0.45);
                ctx.stroke();

                // ----- 6. 少女侧脸剪影（趴在窗边，深色大剪影） -----
                // 画在窗户前景的下半部
                ctx.fillStyle = '#1a0c1a';
                ctx.beginPath();
                const gx = winX + winW * 0.35;  // 脸中心 x
                const gy = h * 0.62;             // 下巴高度
                // 头发（大块上部）
                ctx.moveTo(gx - 50, gy);
                ctx.quadraticCurveTo(gx - 80, gy - 80, gx - 65, gy - 150);
                ctx.quadraticCurveTo(gx - 45, gy - 195, gx - 5, gy - 190);
                ctx.quadraticCurveTo(gx + 35, gy - 185, gx + 48, gy - 140);
                // 鼻子凸起
                ctx.quadraticCurveTo(gx + 52, gy - 118, gx + 56, gy - 100);
                ctx.quadraticCurveTo(gx + 52, gy - 88, gx + 45, gy - 80);
                // 嘴唇凸起
                ctx.quadraticCurveTo(gx + 49, gy - 65, gx + 42, gy - 50);
                // 下巴
                ctx.quadraticCurveTo(gx + 36, gy - 20, gx + 20, gy - 5);
                // 脖子
                ctx.lineTo(gx + 15, gy + 40);
                // 肩膀到底
                ctx.lineTo(gx + 80, gy + 90);
                ctx.lineTo(gx + 80, h);
                ctx.lineTo(winX - 20, h);
                ctx.lineTo(winX - 20, gy + 80);
                // 手臂/肩回到头顶
                ctx.quadraticCurveTo(gx - 70, gy + 30, gx - 50, gy);
                ctx.closePath();
                ctx.fill();

                // 头发光（从上方打下来的轮廓高光）
                const hairG = ctx.createLinearGradient(gx, gy - 200, gx, gy);
                hairG.addColorStop(0, 'rgba(255, 200, 180, 0.35)');
                hairG.addColorStop(0.5, 'rgba(255, 150, 150, 0.08)');
                hairG.addColorStop(1, 'rgba(0, 0, 0, 0)');
                ctx.fillStyle = hairG;
                ctx.beginPath();
                ctx.moveTo(gx - 65, gy - 150);
                ctx.quadraticCurveTo(gx - 45, gy - 195, gx - 5, gy - 190);
                ctx.quadraticCurveTo(gx + 35, gy - 185, gx + 48, gy - 140);
                ctx.lineTo(gx + 40, gy - 135);
                ctx.quadraticCurveTo(gx + 20, gy - 175, gx - 5, gy - 178);
                ctx.quadraticCurveTo(gx - 40, gy - 180, gx - 55, gy - 148);
                ctx.closePath();
                ctx.fill();

                // ----- 7. 飘落樱花 -----
                st.petals.forEach(p => {
                    p.y += p.vy * p.depth;
                    p.x += p.vx + Math.sin(t / 1200 + p.swayPhase) * 0.4;
                    p.rot += p.rotSpeed;
                    if (p.y > h + 20) { p.y = -20; p.x = Math.random() * w; }
                    if (p.x < -20) p.x = w + 20;
                    if (p.x > w + 20) p.x = -20;
                    const size = p.size * p.depth;
                    const alpha = 0.6 + p.depth * 0.4;
                    const color = `hsla(340, 80%, ${78 + p.depth * 10}%, ${alpha})`;
                    drawPetal(ctx, p.x, p.y, size, p.rot, color);
                });

                // ----- 8. 轻微光晕叠加（让画面柔化） -----
                const softness = ctx.createRadialGradient(w * 0.5, h * 0.5, 50, w * 0.5, h * 0.5, Math.max(w, h) * 0.8);
                softness.addColorStop(0, 'rgba(255, 220, 200, 0)');
                softness.addColorStop(1, 'rgba(60, 30, 60, 0.3)');
                ctx.fillStyle = softness;
                ctx.fillRect(0, 0, w, h);
            }
        },

        sunsetTown: {
            name: '黄昏小镇', icon: '🌇',
            state: null,
            init(w, h) {
                // 飞鸟 6 只
                const birds = [];
                for (let i = 0; i < 7; i++) {
                    birds.push({
                        x: Math.random() * w,
                        y: h * (0.15 + Math.random() * 0.25),
                        vx: 0.4 + Math.random() * 0.3,
                        flap: Math.random() * Math.PI * 2,
                    });
                }
                // 云
                const clouds = [];
                for (let i = 0; i < 4; i++) {
                    clouds.push({
                        x: Math.random() * w,
                        y: h * (0.1 + Math.random() * 0.2),
                        w: 80 + Math.random() * 120,
                        vx: 0.08 + Math.random() * 0.12,
                        alpha: 0.4 + Math.random() * 0.3,
                    });
                }
                this.state = { birds, clouds, lastW: w, lastH: h };
            },
            render(ctx, w, h, t) {
                if (!this.state || this.state.lastW !== w || this.state.lastH !== h) this.init(w, h);
                const st = this.state;

                // ----- 1. 晚霞渐变（紫→粉→橙） -----
                const sky = ctx.createLinearGradient(0, 0, 0, h);
                sky.addColorStop(0, '#3a1f4a');
                sky.addColorStop(0.3, '#8a4a7a');
                sky.addColorStop(0.55, '#e87a8a');
                sky.addColorStop(0.75, '#ffb878');
                sky.addColorStop(1, '#2a1828');
                ctx.fillStyle = sky;
                ctx.fillRect(0, 0, w, h);

                // ----- 2. 太阳（半落地平线）-----
                const sunY = h * 0.7;
                const sunR = h * 0.08;
                const sunG = ctx.createRadialGradient(w * 0.5, sunY, 0, w * 0.5, sunY, sunR * 5);
                sunG.addColorStop(0, 'rgba(255, 240, 200, 1)');
                sunG.addColorStop(0.2, 'rgba(255, 200, 140, 0.85)');
                sunG.addColorStop(1, 'rgba(255, 180, 120, 0)');
                ctx.fillStyle = sunG;
                ctx.fillRect(0, sunY - sunR * 5, w, sunR * 10);
                ctx.fillStyle = '#fff2c0';
                ctx.beginPath();
                ctx.arc(w * 0.5, sunY, sunR, 0, Math.PI * 2);
                ctx.fill();

                // ----- 3. 云 -----
                st.clouds.forEach(c => {
                    c.x += c.vx;
                    if (c.x - c.w > w) c.x = -c.w;
                    drawCloud(ctx, c.x, c.y, c.w, `rgba(255, 220, 210, ${c.alpha})`);
                });

                // ----- 4. 远山 -----
                ctx.fillStyle = '#5a3060';
                drawMountain(ctx, w, h * 0.72, h * 0.1, 0);
                ctx.fillStyle = '#3a1e48';
                drawMountain(ctx, w, h * 0.76, h * 0.12, 2);

                // ----- 5. 屋顶剪影群 -----
                ctx.fillStyle = '#1a0c20';
                drawRoofs(ctx, w, h * 0.82, h * 0.12);

                // ----- 6. 电线杆 + 电线 -----
                ctx.strokeStyle = '#0a0418';
                ctx.fillStyle = '#0a0418';
                ctx.lineWidth = 2;
                const polePositions = [w * 0.15, w * 0.55, w * 0.85];
                polePositions.forEach(px => {
                    // 杆
                    ctx.fillRect(px - 1.5, h * 0.55, 3, h * 0.35);
                    // 横杆
                    ctx.fillRect(px - 18, h * 0.58, 36, 2);
                });
                // 三根电线（带下垂弧度）
                ctx.strokeStyle = '#0a0418';
                ctx.lineWidth = 1.2;
                for (let wire = 0; wire < 3; wire++) {
                    const dy = wire * 3;
                    ctx.beginPath();
                    ctx.moveTo(0, h * 0.6 + dy);
                    ctx.quadraticCurveTo(polePositions[0], h * 0.63 + dy, polePositions[0], h * 0.58 + dy);
                    ctx.quadraticCurveTo(polePositions[0], h * 0.58 + dy, (polePositions[0] + polePositions[1]) / 2, h * 0.64 + dy);
                    ctx.quadraticCurveTo(polePositions[1], h * 0.58 + dy, polePositions[1], h * 0.58 + dy);
                    ctx.quadraticCurveTo(polePositions[1], h * 0.58 + dy, (polePositions[1] + polePositions[2]) / 2, h * 0.64 + dy);
                    ctx.quadraticCurveTo(polePositions[2], h * 0.58 + dy, polePositions[2], h * 0.58 + dy);
                    ctx.quadraticCurveTo(polePositions[2], h * 0.63 + dy, w, h * 0.62 + dy);
                    ctx.stroke();
                }

                // ----- 7. 小鸟停在电线上（2 只）-----
                drawBirdOnWire(ctx, w * 0.35, h * 0.58);
                drawBirdOnWire(ctx, w * 0.70, h * 0.585);

                // ----- 8. 飞行的鸟 -----
                st.birds.forEach(b => {
                    b.x += b.vx;
                    b.flap += 0.15;
                    if (b.x > w + 20) b.x = -20;
                    drawFlyingBird(ctx, b.x, b.y, b.flap);
                });
            }
        },

        starryGirl: {
            name: '星空少女', icon: '🌌',
            state: null,
            init(w, h) {
                // 星星
                const stars = [];
                for (let i = 0; i < 200; i++) {
                    stars.push({
                        x: Math.random() * w,
                        y: Math.random() * h * 0.75,
                        r: Math.random() * 1.4 + 0.2,
                        phase: Math.random() * Math.PI * 2,
                    });
                }
                // 流星时间（每 8-14 秒随机一颗）
                this.state = { stars, meteorStart: -5000, meteorDur: 1500, nextMeteor: 3000, lastW: w, lastH: h };
            },
            render(ctx, w, h, t) {
                if (!this.state || this.state.lastW !== w || this.state.lastH !== h) this.init(w, h);
                const st = this.state;

                // ----- 1. 深蓝夜空渐变 -----
                const sky = ctx.createLinearGradient(0, 0, 0, h);
                sky.addColorStop(0, '#0a0e2a');
                sky.addColorStop(0.4, '#1a1e4a');
                sky.addColorStop(0.7, '#3a2e5a');
                sky.addColorStop(1, '#1a0c1a');
                ctx.fillStyle = sky;
                ctx.fillRect(0, 0, w, h);

                // ----- 2. 银河（斜向柔光带） -----
                ctx.save();
                ctx.translate(w * 0.5, h * 0.35);
                ctx.rotate(-0.25);
                const milky = ctx.createLinearGradient(-w, 0, w, 0);
                milky.addColorStop(0, 'rgba(255, 200, 230, 0)');
                milky.addColorStop(0.3, 'rgba(200, 180, 255, 0.15)');
                milky.addColorStop(0.5, 'rgba(255, 220, 240, 0.22)');
                milky.addColorStop(0.7, 'rgba(160, 200, 255, 0.15)');
                milky.addColorStop(1, 'rgba(100, 150, 200, 0)');
                ctx.fillStyle = milky;
                ctx.fillRect(-w, -h * 0.08, w * 2, h * 0.16);
                ctx.restore();

                // ----- 3. 星星（带闪烁） -----
                st.stars.forEach(s => {
                    const twinkle = 0.4 + Math.sin(t / 400 + s.phase) * 0.6;
                    ctx.fillStyle = `rgba(255, 255, 240, ${twinkle * 0.85})`;
                    ctx.beginPath();
                    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                    ctx.fill();
                });

                // ----- 4. 流星 -----
                const sinceStart = t - st.meteorStart;
                if (sinceStart > st.nextMeteor) {
                    st.meteorStart = t;
                    st.nextMeteor = 8000 + Math.random() * 6000;
                    st.meteorFromX = Math.random() * w * 0.6;
                    st.meteorFromY = h * 0.05 + Math.random() * h * 0.3;
                    st.meteorDx = w * 0.25 + Math.random() * w * 0.2;
                    st.meteorDy = h * 0.25 + Math.random() * h * 0.15;
                }
                const mp = sinceStart / st.meteorDur;
                if (mp > 0 && mp < 1) {
                    const mx = st.meteorFromX + st.meteorDx * mp;
                    const my = st.meteorFromY + st.meteorDy * mp;
                    const tailLen = 100;
                    const dx = st.meteorDx / Math.hypot(st.meteorDx, st.meteorDy);
                    const dy = st.meteorDy / Math.hypot(st.meteorDx, st.meteorDy);
                    const tailG = ctx.createLinearGradient(mx - dx * tailLen, my - dy * tailLen, mx, my);
                    tailG.addColorStop(0, 'rgba(255, 220, 255, 0)');
                    tailG.addColorStop(1, 'rgba(255, 240, 255, 0.9)');
                    ctx.strokeStyle = tailG;
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.moveTo(mx - dx * tailLen, my - dy * tailLen);
                    ctx.lineTo(mx, my);
                    ctx.stroke();
                    // 头部亮点
                    ctx.shadowColor = '#ffe8ff';
                    ctx.shadowBlur = 10;
                    ctx.fillStyle = '#ffffff';
                    ctx.beginPath();
                    ctx.arc(mx, my, 2.5, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.shadowBlur = 0;
                }

                // ----- 5. 远山剪影 -----
                ctx.fillStyle = '#0a0818';
                drawMountain(ctx, w, h * 0.72, h * 0.15, 3);

                // ----- 6. 草地 -----
                ctx.fillStyle = '#050410';
                ctx.fillRect(0, h * 0.82, w, h * 0.18);

                // ----- 7. 少女剪影（躺卧 / 望天，大剪影） -----
                // 位置：右下角，侧躺着望天
                ctx.fillStyle = '#000005';
                const gx = w * 0.68, gy = h * 0.88;
                ctx.beginPath();
                // 头发（散开在地）
                ctx.moveTo(gx - 90, gy);
                ctx.quadraticCurveTo(gx - 140, gy - 10, gx - 160, gy + 10);
                ctx.lineTo(gx - 160, gy + 40);
                ctx.lineTo(gx + 200, gy + 40);
                ctx.lineTo(gx + 200, gy - 5);
                // 身体曲线（脚朝右）
                ctx.quadraticCurveTo(gx + 140, gy - 8, gx + 80, gy - 25);
                // 腰部
                ctx.quadraticCurveTo(gx + 30, gy - 35, gx - 10, gy - 40);
                // 肩膀
                ctx.quadraticCurveTo(gx - 40, gy - 50, gx - 55, gy - 60);
                // 脖子
                ctx.lineTo(gx - 62, gy - 50);
                // 下巴
                ctx.quadraticCurveTo(gx - 72, gy - 42, gx - 82, gy - 45);
                // 侧脸（简化）
                ctx.quadraticCurveTo(gx - 95, gy - 50, gx - 100, gy - 40);
                // 鼻尖
                ctx.quadraticCurveTo(gx - 105, gy - 35, gx - 100, gy - 28);
                // 头发边
                ctx.quadraticCurveTo(gx - 95, gy - 20, gx - 90, gy);
                ctx.closePath();
                ctx.fill();

                // 头发反光（轮廓光）
                const hairL = ctx.createLinearGradient(gx - 100, gy - 50, gx + 100, gy + 40);
                hairL.addColorStop(0, 'rgba(180, 200, 255, 0.25)');
                hairL.addColorStop(0.5, 'rgba(180, 200, 255, 0.08)');
                hairL.addColorStop(1, 'rgba(0, 0, 0, 0)');
                ctx.fillStyle = hairL;
                ctx.beginPath();
                ctx.moveTo(gx - 90, gy);
                ctx.quadraticCurveTo(gx - 140, gy - 10, gx - 160, gy + 10);
                ctx.lineTo(gx - 155, gy + 15);
                ctx.quadraticCurveTo(gx - 135, gy - 5, gx - 90, gy + 5);
                ctx.closePath();
                ctx.fill();
            }
        },

        beachSummer: {
            name: '海边盛夏', icon: '🌊',
            state: null,
            init(w, h) {
                const seagulls = [];
                for (let i = 0; i < 5; i++) {
                    seagulls.push({
                        x: Math.random() * w,
                        y: h * (0.12 + Math.random() * 0.2),
                        vx: 0.3 + Math.random() * 0.3,
                        flap: Math.random() * Math.PI * 2,
                    });
                }
                const clouds = [];
                for (let i = 0; i < 5; i++) {
                    clouds.push({
                        x: Math.random() * w,
                        y: h * (0.1 + Math.random() * 0.15),
                        w: 100 + Math.random() * 140,
                        vx: 0.1 + Math.random() * 0.08,
                    });
                }
                this.state = { seagulls, clouds, lastW: w, lastH: h };
            },
            render(ctx, w, h, t) {
                if (!this.state || this.state.lastW !== w || this.state.lastH !== h) this.init(w, h);
                const st = this.state;

                // ----- 1. 青蓝天空渐变 -----
                const sky = ctx.createLinearGradient(0, 0, 0, h * 0.6);
                sky.addColorStop(0, '#6ab8e8');
                sky.addColorStop(0.5, '#a8d8f0');
                sky.addColorStop(1, '#e8f4f8');
                ctx.fillStyle = sky;
                ctx.fillRect(0, 0, w, h * 0.6);

                // ----- 2. 白云 -----
                st.clouds.forEach(c => {
                    c.x += c.vx;
                    if (c.x - c.w > w) c.x = -c.w;
                    drawCloud(ctx, c.x, c.y, c.w, 'rgba(255, 255, 255, 0.92)');
                });

                // ----- 3. 远处海平线（深青） -----
                const deepSea = ctx.createLinearGradient(0, h * 0.58, 0, h * 0.75);
                deepSea.addColorStop(0, '#3a7aa0');
                deepSea.addColorStop(1, '#5aaac0');
                ctx.fillStyle = deepSea;
                ctx.fillRect(0, h * 0.58, w, h * 0.17);

                // ----- 4. 海浪（动态正弦波） -----
                for (let layer = 0; layer < 3; layer++) {
                    const yBase = h * (0.6 + layer * 0.05);
                    const amp = 3 + layer * 2;
                    const speed = 0.0004 - layer * 0.00008;
                    const color = ['rgba(255,255,255,0.45)', 'rgba(200,230,240,0.35)', 'rgba(150,200,220,0.4)'][layer];
                    ctx.fillStyle = color;
                    ctx.beginPath();
                    ctx.moveTo(0, yBase + 20);
                    for (let x = 0; x <= w; x += 10) {
                        const y = yBase + Math.sin(x * 0.015 + t * speed + layer) * amp;
                        ctx.lineTo(x, y);
                    }
                    ctx.lineTo(w, h * 0.75);
                    ctx.lineTo(0, h * 0.75);
                    ctx.closePath();
                    ctx.fill();
                }

                // ----- 5. 近岸海水（浅绿松石） -----
                const shallow = ctx.createLinearGradient(0, h * 0.73, 0, h * 0.86);
                shallow.addColorStop(0, '#7adac8');
                shallow.addColorStop(1, '#b8e8d8');
                ctx.fillStyle = shallow;
                ctx.fillRect(0, h * 0.73, w, h * 0.13);

                // 海浪白沫（近岸）
                ctx.fillStyle = 'rgba(255, 255, 255, 0.65)';
                ctx.beginPath();
                ctx.moveTo(0, h * 0.85);
                for (let x = 0; x <= w; x += 8) {
                    const foam = Math.sin(x * 0.05 + t * 0.0015) * 3 + Math.sin(x * 0.12 + t * 0.003) * 2;
                    ctx.lineTo(x, h * 0.85 + foam);
                }
                ctx.lineTo(w, h * 0.87);
                ctx.lineTo(0, h * 0.87);
                ctx.closePath();
                ctx.fill();

                // ----- 6. 沙滩 -----
                const sand = ctx.createLinearGradient(0, h * 0.86, 0, h);
                sand.addColorStop(0, '#f4e0b8');
                sand.addColorStop(1, '#d8b88a');
                ctx.fillStyle = sand;
                ctx.fillRect(0, h * 0.86, w, h * 0.14);

                // ----- 7. 沙滩伞（右侧） -----
                const uX = w * 0.82;
                const uY = h * 0.87;
                // 杆
                ctx.fillStyle = '#5a3820';
                ctx.fillRect(uX - 2, uY, 4, h * 0.12);
                // 伞面（红白条纹）
                const uR = h * 0.08;
                for (let i = 0; i < 8; i++) {
                    const a1 = Math.PI + (i / 8) * Math.PI;
                    const a2 = Math.PI + ((i + 1) / 8) * Math.PI;
                    ctx.fillStyle = i % 2 === 0 ? '#e85a5a' : '#ffffff';
                    ctx.beginPath();
                    ctx.moveTo(uX, uY);
                    ctx.arc(uX, uY, uR, a1, a2);
                    ctx.closePath();
                    ctx.fill();
                }
                // 伞边
                ctx.strokeStyle = '#aa3030';
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.arc(uX, uY, uR, Math.PI, Math.PI * 2);
                ctx.stroke();

                // ----- 8. 海鸥 -----
                st.seagulls.forEach(b => {
                    b.x += b.vx;
                    b.flap += 0.12;
                    if (b.x > w + 20) b.x = -20;
                    drawFlyingBird(ctx, b.x, b.y, b.flap);
                });

                // ----- 9. 阳光反光（海面亮带） -----
                const glimmer = ctx.createLinearGradient(0, h * 0.62, 0, h * 0.72);
                glimmer.addColorStop(0, 'rgba(255, 255, 255, 0)');
                glimmer.addColorStop(0.5, `rgba(255, 255, 200, ${0.25 + Math.sin(t / 800) * 0.1})`);
                glimmer.addColorStop(1, 'rgba(255, 255, 255, 0)');
                ctx.fillStyle = glimmer;
                ctx.fillRect(w * 0.3, h * 0.62, w * 0.4, h * 0.1);
            }
        }
    };

    // ===== 插画工具函数 =====
    function drawPetal(ctx, x, y, size, rot, color) {
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(rot);
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.moveTo(0, -size);
        ctx.quadraticCurveTo(size * 0.85, -size * 0.6, size * 0.5, size * 0.3);
        ctx.quadraticCurveTo(size * 0.15, size * 0.1, 0, size * 0.4);
        ctx.quadraticCurveTo(-size * 0.15, size * 0.1, -size * 0.5, size * 0.3);
        ctx.quadraticCurveTo(-size * 0.85, -size * 0.6, 0, -size);
        ctx.fill();
        ctx.restore();
    }

    // 稳定随机（基于种子）
    function srand(seed) {
        const x = Math.sin(seed * 12.9898) * 43758.5453;
        return x - Math.floor(x);
    }

    function drawSakuraTreeSilhouette(ctx, x, y, w, h, color) {
        // 树干
        ctx.fillStyle = color;
        ctx.fillRect(x + w * 0.45, y, w * 0.1, h * 0.5);
        // 树冠 —— 多个椭圆球块堆叠模拟蓬松花团
        for (let i = 0; i < 10; i++) {
            const cx = x + w * 0.5 + (srand(i * 7.3) - 0.5) * w * 0.8;
            const cy = y + (srand(i * 11.7) - 0.3) * h * 0.5;
            const r = w * (0.25 + srand(i * 3.1) * 0.2);
            ctx.fillStyle = `rgba(${parseInt(color.slice(1,3),16)}, ${parseInt(color.slice(3,5),16)}, ${parseInt(color.slice(5,7),16)}, ${0.7 + srand(i*5)*0.3})`;
            ctx.beginPath();
            ctx.arc(cx, cy, r, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    function drawCloud(ctx, x, y, w, color) {
        ctx.fillStyle = color;
        const puffs = [
            { dx: 0,      dy: 0, r: w * 0.25 },
            { dx: w*0.20, dy: -w * 0.08, r: w * 0.22 },
            { dx: w*0.40, dy: 0, r: w * 0.20 },
            { dx: -w*0.18, dy: 0, r: w * 0.18 },
        ];
        puffs.forEach(p => {
            ctx.beginPath();
            ctx.arc(x + p.dx, y + p.dy, p.r, 0, Math.PI * 2);
            ctx.fill();
        });
    }

    function drawMountain(ctx, w, baseY, h_amt, seed) {
        ctx.beginPath();
        ctx.moveTo(0, baseY + 20);
        const segs = 40;
        for (let i = 0; i <= segs; i++) {
            const x = (w / segs) * i;
            const n = Math.sin(i * 0.35 + seed) * 0.5 + Math.sin(i * 0.9 + seed * 2) * 0.3;
            const y = baseY - h_amt * (0.4 + n * 0.6);
            ctx.lineTo(x, y);
        }
        ctx.lineTo(w, baseY + 20);
        ctx.closePath();
        ctx.fill();
    }

    function drawRoofs(ctx, w, baseY, h_amt) {
        ctx.beginPath();
        ctx.moveTo(0, baseY + 40);
        let x = 0;
        while (x < w) {
            const bw = 35 + srand(x * 0.13) * 60;
            const bh = h_amt * (0.35 + srand(x * 0.27) * 0.6);
            const type = srand(x * 0.19);
            if (type < 0.5) {
                // 尖顶
                ctx.lineTo(x, baseY - bh * 0.3);
                ctx.lineTo(x + bw * 0.5, baseY - bh);
                ctx.lineTo(x + bw, baseY - bh * 0.3);
            } else {
                // 平顶
                ctx.lineTo(x, baseY - bh * 0.7);
                ctx.lineTo(x + bw, baseY - bh * 0.7);
            }
            x += bw;
        }
        ctx.lineTo(w, baseY + 40);
        ctx.closePath();
        ctx.fill();
    }

    function drawBirdOnWire(ctx, x, y) {
        ctx.fillStyle = '#0a0418';
        // 身体
        ctx.beginPath();
        ctx.ellipse(x, y - 4, 4, 3, 0, 0, Math.PI * 2);
        ctx.fill();
        // 头
        ctx.beginPath();
        ctx.arc(x - 4, y - 5, 2, 0, Math.PI * 2);
        ctx.fill();
        // 尾
        ctx.beginPath();
        ctx.moveTo(x + 3, y - 4);
        ctx.lineTo(x + 7, y - 6);
        ctx.lineTo(x + 3, y - 3);
        ctx.closePath();
        ctx.fill();
    }

    function drawFlyingBird(ctx, x, y, flap) {
        const wingUp = Math.sin(flap) * 6;
        ctx.strokeStyle = '#0a0418';
        ctx.lineWidth = 1.8;
        ctx.lineCap = 'round';
        ctx.beginPath();
        // M 形翅膀
        ctx.moveTo(x - 10, y + wingUp);
        ctx.quadraticCurveTo(x - 5, y - 3, x, y);
        ctx.quadraticCurveTo(x + 5, y - 3, x + 10, y + wingUp);
        ctx.stroke();
    }

    // 共用工具
    const starCache = new Map();
    function drawStars(ctx, w, h, n, t) {
        const key = `${w}x${h}_${n}`;
        if (!starCache.has(key)) {
            const arr = [];
            for (let i = 0; i < n; i++) {
                arr.push({
                    x: Math.random() * w,
                    y: Math.random() * h,
                    r: Math.random() * 1.1 + 0.2,
                    b: 0.3 + Math.random() * 0.7,
                    phase: Math.random() * Math.PI * 2
                });
            }
            starCache.set(key, arr);
        }
        const stars = starCache.get(key);
        ctx.fillStyle = '#fff';
        stars.forEach(s => {
            const twinkle = 0.7 + Math.sin(t / 1800 + s.phase) * 0.3;
            ctx.globalAlpha = 0.5 * s.b * twinkle;
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
            ctx.fill();
        });
        ctx.globalAlpha = 1;
    }

    function drawNebula(ctx, x, y, r, color) {
        const g = ctx.createRadialGradient(x, y, 0, x, y, r);
        g.addColorStop(0, color);
        g.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = g;
        ctx.fillRect(x - r, y - r, r*2, r*2);
    }

    function drawMeteor(ctx, w, h, t, offset) {
        const period = 14000;
        const phase = ((t + offset) % period) / period;
        if (phase > 0.15) return;  // 只在开头 15% 露一下
        const progress = phase / 0.15;
        const x0 = w * 0.1;
        const y0 = h * 0.15;
        const x = x0 + progress * w * 0.5;
        const y = y0 + progress * h * 0.3;
        const tailLen = 80;
        const grad = ctx.createLinearGradient(x - tailLen, y - tailLen*0.6, x, y);
        grad.addColorStop(0, 'rgba(255,255,255,0)');
        grad.addColorStop(1, 'rgba(255,255,255,0.8)');
        ctx.strokeStyle = grad;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(x - tailLen, y - tailLen*0.6);
        ctx.lineTo(x, y);
        ctx.stroke();
    }

    // ---- 状态 ----
    let curMode = 'classroom';
    let running = false;
    let animRAF = null;
    let startTime = 0;

    function resize() {
        const dpr = Math.min(devicePixelRatio, 2);
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function loop() {
        if (!running) return;
        const w = window.innerWidth;
        const h = window.innerHeight;
        // 若 canvas 尺寸和窗口不一致，重算
        const dpr = Math.min(devicePixelRatio, 2);
        if (canvas.width !== w * dpr) resize();
        const t = performance.now() - startTime;
        MODES[curMode].render(ctx, w, h, t);
        animRAF = requestAnimationFrame(loop);
    }

    function start() {
        running = true;
        startTime = performance.now();
        document.body.classList.add('wp-bg-on');
        btn.classList.add('active');
        resize();
        loop();
        try { localStorage.setItem(KEY_ON, '1'); } catch(e){}
    }

    function stop() {
        running = false;
        cancelAnimationFrame(animRAF);
        document.body.classList.remove('wp-bg-on');
        btn.classList.remove('active');
        // 清画布，免得留残影
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        try { localStorage.setItem(KEY_ON, '0'); } catch(e){}
    }

    function setMode(mode) {
        if (!MODES[mode]) return;
        curMode = mode;
        try { localStorage.setItem(KEY_MODE, mode); } catch(e){}
        renderMenu();
        if (!running) start();  // 选了某个就自动开启
    }

    function toggle() {
        if (running) stop(); else start();
    }

    function renderMenu() {
        let html = '<div class="wpbg-menu-label">背景模式</div>';
        Object.entries(MODES).forEach(([key, m]) => {
            html += `<div class="wpbg-menu-item${key === curMode ? ' active' : ''}" data-mode="${key}">
                <span><span class="wpbg-mi-icon">${m.icon}</span> ${m.name}</span>
                ${key === curMode && running ? '<span style="color:var(--success)">●</span>' : ''}
            </div>`;
        });
        html += '<div class="wpbg-menu-divider"></div>';
        html += `<div class="wpbg-menu-item" data-mode="__custom__">
            <span><span class="wpbg-mi-icon">🖼</span> 我的动漫壁纸</span>
        </div>`;
        html += `<div class="wpbg-menu-item" data-mode="__off__">
            <span>⊘ 关闭背景</span>
            ${!running ? '<span style="color:var(--text-muted)">●</span>' : ''}
        </div>`;
        menu.innerHTML = html;
        menu.querySelectorAll('.wpbg-menu-item').forEach(el => {
            el.addEventListener('click', () => {
                const m = el.dataset.mode;
                if (m === '__off__') stop();
                else if (m === '__custom__') {
                    if (typeof window.__wpImgOpen === 'function') window.__wpImgOpen();
                }
                else setMode(m);
                hideMenu();
            });
        });
    }

    function showMenu() { renderMenu(); menu.classList.add('visible'); }
    function hideMenu() { menu.classList.remove('visible'); }

    // ---- 事件绑定 ----
    btn.addEventListener('click', (e) => {
        e.stopPropagation();
        // 有菜单则关；没菜单则开菜单（如果已开背景）或直接开启星场
        if (menu.classList.contains('visible')) {
            hideMenu();
            return;
        }
        if (!running) {
            start();  // 第一次点直接开
            // 稍后再展示菜单让用户选
            setTimeout(showMenu, 50);
        } else {
            showMenu();
        }
    });

    document.addEventListener('click', (e) => {
        if (!menu.contains(e.target) && e.target !== btn) hideMenu();
    });

    window.addEventListener('resize', () => {
        if (running) resize();
    });

    // 快捷键 ⌘\
    document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === '\\') {
            e.preventDefault();
            toggle();
        }
    });

    // ---- 恢复上次状态 ----
    try {
        const savedMode = localStorage.getItem(KEY_MODE);
        if (savedMode && MODES[savedMode]) curMode = savedMode;
        if (localStorage.getItem(KEY_ON) === '1') start();
    } catch(e){}
})();


// ====== 自定义壁纸图片管理 ======
(function wpImg(){
    const modal = document.getElementById('wpImgModal');
    const closeBtn = document.getElementById('wpImgClose');
    const grid = document.getElementById('wpImgGrid');
    const uploadBtn = document.getElementById('wpImgUploadBtn');
    const fileInput = document.getElementById('wpImgFileInput');
    const enableCb = document.getElementById('wpImgEnable');
    const intervalInput = document.getElementById('wpImgInterval');
    const layer = document.getElementById('wpImgLayer');
    if (!modal || !layer) return;

    // IndexedDB: interview-wp / images
    const DB = 'interview-wp';
    const STORE = 'images';
    let dbReady = null;
    function openDB() {
        if (dbReady) return dbReady;
        dbReady = new Promise((resolve, reject) => {
            const req = indexedDB.open(DB, 1);
            req.onupgradeneeded = (e) => {
                const d = e.target.result;
                if (!d.objectStoreNames.contains(STORE)) {
                    d.createObjectStore(STORE, { keyPath: 'id', autoIncrement: true });
                }
            };
            req.onsuccess = () => resolve(req.result);
            req.onerror = () => reject(req.error);
        });
        return dbReady;
    }
    async function dbAll() {
        const d = await openDB();
        return new Promise((res, rej) => {
            const tx = d.transaction(STORE, 'readonly');
            const r = tx.objectStore(STORE).getAll();
            r.onsuccess = () => res(r.result.sort((a,b) => a.order - b.order));
            r.onerror = () => rej(r.error);
        });
    }
    async function dbAdd(obj) {
        const d = await openDB();
        return new Promise((res, rej) => {
            const tx = d.transaction(STORE, 'readwrite');
            const r = tx.objectStore(STORE).add(obj);
            r.onsuccess = () => res(r.result);
            r.onerror = () => rej(r.error);
        });
    }
    async function dbDelete(id) {
        const d = await openDB();
        return new Promise((res, rej) => {
            const tx = d.transaction(STORE, 'readwrite');
            const r = tx.objectStore(STORE).delete(id);
            r.onsuccess = () => res();
            r.onerror = () => rej(r.error);
        });
    }

    // ---- 状态 ----
    const KEY_ENABLE = 'wpimg-enable';
    const KEY_INTERVAL = 'wpimg-interval';
    let urls = new Map();  // id -> objectURL
    let playlist = [];     // 切图用
    let curIdx = 0;
    let switchIv = null;
    let curIntervalSec = 30;

    // 读配置
    try {
        const iv = parseInt(localStorage.getItem(KEY_INTERVAL), 10);
        if (iv >= 5 && iv <= 600) curIntervalSec = iv;
    } catch(e){}

    function revokeAll() {
        for (const u of urls.values()) try { URL.revokeObjectURL(u); } catch(e){}
        urls = new Map();
    }

    async function refreshPlaylist() {
        revokeAll();
        const all = await dbAll();
        playlist = all.map(r => {
            const u = URL.createObjectURL(r.blob);
            urls.set(r.id, u);
            return { id: r.id, url: u };
        });
        return all;
    }

    // ---- 面板渲染 ----
    async function renderGrid() {
        const all = await refreshPlaylist();
        if (all.length === 0) {
            grid.innerHTML = `<div class="wpimg-empty">
                还没上传壁纸
                <div class="wpimg-empty-hint">点上方「+ 上传图片」选文件（支持多选，jpg/png/webp）</div>
            </div>`;
            return;
        }
        grid.innerHTML = '';
        all.forEach((r, i) => {
            const url = urls.get(r.id);
            const el = document.createElement('div');
            el.className = 'wpimg-item';
            el.innerHTML = `
                <img src="${url}" alt="">
                <div class="wpimg-item-badge">#${i + 1}</div>
                <button class="wpimg-item-del" title="删除">✕</button>
            `;
            el.querySelector('.wpimg-item-del').addEventListener('click', async (e) => {
                e.stopPropagation();
                if (!confirm('删除这张壁纸？')) return;
                await dbDelete(r.id);
                await renderGrid();
                restartPlayback();
            });
            grid.appendChild(el);
        });
    }

    // ---- 上传 ----
    uploadBtn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', async (e) => {
        const files = Array.from(e.target.files || []);
        if (files.length === 0) return;
        for (const f of files) {
            if (!f.type.startsWith('image/')) continue;
            const blob = f;
            const existing = await dbAll();
            const order = existing.length;
            await dbAdd({ blob, order, name: f.name, createdAt: Date.now() });
        }
        fileInput.value = '';
        await renderGrid();
        restartPlayback();
    });

    // ---- 启用复选框 ----
    enableCb.addEventListener('change', () => {
        if (enableCb.checked) enableImgMode();
        else disableImgMode();
    });

    // 间隔输入
    intervalInput.value = curIntervalSec;
    intervalInput.addEventListener('change', () => {
        const v = parseInt(intervalInput.value, 10);
        if (v >= 5 && v <= 600) {
            curIntervalSec = v;
            try { localStorage.setItem(KEY_INTERVAL, String(v)); } catch(e){}
            restartPlayback();
        } else {
            intervalInput.value = curIntervalSec;
        }
    });

    // ---- 播放控制 ----
    function enableImgMode() {
        try { localStorage.setItem(KEY_ENABLE, '1'); } catch(e){}
        document.body.classList.add('wp-img-mode');
        // 确保背景本身也打开了
        document.body.classList.add('wp-bg-on');
        // 同步按钮 active 态（和 wpBgBtn 联动）
        const bgBtn = document.getElementById('wpBgBtn');
        if (bgBtn) bgBtn.classList.add('active');
        restartPlayback();
    }
    function disableImgMode() {
        try { localStorage.setItem(KEY_ENABLE, '0'); } catch(e){}
        document.body.classList.remove('wp-img-mode');
        if (switchIv) { clearInterval(switchIv); switchIv = null; }
        // 清掉当前显示的图，让 canvas 恢复
        layer.innerHTML = '';
    }

    function restartPlayback() {
        if (!document.body.classList.contains('wp-img-mode')) return;
        if (switchIv) { clearInterval(switchIv); switchIv = null; }
        if (playlist.length === 0) {
            layer.innerHTML = '<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.4);font-size:14px;">请上传图片</div>';
            return;
        }
        curIdx = 0;
        showImage(0);
        if (playlist.length > 1) {
            switchIv = setInterval(() => {
                curIdx = (curIdx + 1) % playlist.length;
                showImage(curIdx);
            }, curIntervalSec * 1000);
        }
    }

    function showImage(i) {
        const item = playlist[i];
        if (!item) return;
        // 保留上一张做交叉淡入，最多保留 2 张
        const imgs = layer.querySelectorAll('img');
        if (imgs.length > 1) imgs[0].remove();
        const next = document.createElement('img');
        next.src = item.url;
        next.alt = '';
        layer.appendChild(next);
        // 强制 layout 再加 visible 触发 transition
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                next.classList.add('visible');
                // 旧图淡出
                imgs.forEach(old => old.classList.remove('visible'));
            });
        });
    }

    // ---- 打开面板 ----
    async function open() {
        await renderGrid();
        // 同步 checkbox 状态
        enableCb.checked = document.body.classList.contains('wp-img-mode');
        intervalInput.value = curIntervalSec;
        modal.classList.add('visible');
    }
    function close() { modal.classList.remove('visible'); }

    closeBtn.addEventListener('click', close);
    modal.addEventListener('click', (e) => {
        if (e.target === modal) close();
    });
    document.addEventListener('keydown', (e) => {
        if (modal.classList.contains('visible') && e.key === 'Escape') close();
    });

    // ---- 暴露 API 给 wpBg 菜单调用 ----
    window.__wpImgOpen = open;
    window.__wpImgHasImages = async () => {
        const all = await dbAll();
        return all.length > 0;
    };

    // ---- 启动时恢复 ----
    (async () => {
        await refreshPlaylist();
        const enabled = (() => { try { return localStorage.getItem(KEY_ENABLE) === '1'; } catch(e) { return false; } })();
        if (enabled && playlist.length > 0) {
            // 延迟一小会确保 wpBg 已经 start
            setTimeout(enableImgMode, 100);
        }
    })();
})();
</script>

</body>
</html>
